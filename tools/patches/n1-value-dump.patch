 class ValueType;
 ValueType computeEvaluatorValue(const Board &board);
 
+/// [Zenyth Web N1 측정 전용] 값 헤드 표본 덤프. 환경 변수 RAPFI_VALUE_DUMP=<파일> 이 있을 때만 켜진다.
+/// evaluate() 가 고전 평가 · 창을 이 문맥에 적고, 평가기의 값 헤드가 입력 · 출력과 함께 한 줄을 쓴다.
+struct ValueDumpCtx
+{
+    int16_t classical = 0;
+    int16_t alpha     = 0;
+    int16_t beta      = 0;
+    int16_t ply       = 0;
+    bool    valid     = false;
+};
+extern thread_local ValueDumpCtx valueDumpCtx;
+/// 덤프가 켜져 있는가(첫 호출에서 환경 변수를 한 번 읽는다).
+bool valueDumpEnabled();
+/// 한 줄을 쓴다: 전역 특징 int8[64] · 3×3 구역 특징 int8[9][64] · 대형 헤드 로짓 float[3](승 · 패 · 무) · 문맥.
+void valueDumpWrite(const int8_t *global64,
+                    const int8_t *group576,
+                    float         winLogit,
+                    float         lossLogit,
+                    float         drawLogit);
+
 /// EvalInfo struct contains all information needed to evaluate a position.
