 #include <algorithm>
 #include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
 
 using Evaluation::EvalCfg;
 
+// ── [Zenyth Web N1 측정 전용] 값 헤드 표본 덤프 ─────────────────────────────────
+namespace Evaluation {
+
+thread_local ValueDumpCtx valueDumpCtx;
+
+namespace {
+
+#pragma pack(push, 1)
+/// 한 줄 664바이트(리틀 엔디언). bench/n1/ 의 읽기 쪽과 같은 배치다(v2 — N1b: 구역 특징 추가).
+struct ValueDumpRecord
+{
+    int8_t  global[64];  // crelu<64, 256>(valueSum.global) — 소형 헤드의 입력
+    int8_t  group[576];  // crelu<64, 32>(valueSum.group[i][j]) 3×3 구역(행 우선) — starBlock 앞단
+    float   logits[3];   // 대형 헤드 출력(승 · 패 · 무 로짓, softmax 전)
+    int16_t classical;   // evaluate() 의 고전 평가(basic + threat)
+    int16_t alpha;
+    int16_t beta;
+    int16_t ply;
+    uint8_t valid;       // 1 이면 evaluate() 안에서 불렸다(문맥이 이 호출의 것)
+    uint8_t reserved[3];
+};
+#pragma pack(pop)
+static_assert(sizeof(ValueDumpRecord) == 664);
+
+struct ValueDumpSink
+{
+    std::FILE *file  = nullptr;
+    unsigned   every = 1;
+    std::mutex mutex;
+
+    ValueDumpSink()
+    {
+        const char *path = std::getenv("RAPFI_VALUE_DUMP");
+        if (!path || !*path)
+            return;
+        if (const char *e = std::getenv("RAPFI_VALUE_DUMP_EVERY"))
+            every = std::max(1, std::atoi(e));
+        file = std::fopen(path, "ab");
+        if (file)
+            std::setvbuf(file, nullptr, _IOFBF, 1 << 20);
+    }
+    ~ValueDumpSink()
+    {
+        if (file)
+            std::fclose(file);
+    }
+};
+
+ValueDumpSink &valueDumpSink()
+{
+    static ValueDumpSink sink;
+    return sink;
+}
+
+}  // namespace
+
+bool valueDumpEnabled()
+{
+    return valueDumpSink().file != nullptr;
+}
+
+void valueDumpWrite(const int8_t *global64,
+                    const int8_t *group576,
+                    float         winLogit,
+                    float         lossLogit,
+                    float         drawLogit)
+{
+    ValueDumpSink &sink = valueDumpSink();
+    if (!sink.file)
+        return;
+    thread_local unsigned counter = 0;
+    if (++counter % sink.every != 0)
+        return;
+
+    ValueDumpRecord r {};
+    std::memcpy(r.global, global64, 64);
+    std::memcpy(r.group, group576, 576);
+    r.logits[0] = winLogit;
+    r.logits[1] = lossLogit;
+    r.logits[2] = drawLogit;
+    r.classical = valueDumpCtx.classical;
+    r.alpha     = valueDumpCtx.alpha;
+    r.beta      = valueDumpCtx.beta;
+    r.ply       = valueDumpCtx.ply;
+    r.valid     = valueDumpCtx.valid ? 1 : 0;
+
+    std::lock_guard<std::mutex> lock(sink.mutex);
+    std::fwrite(&r, sizeof(r), 1, sink.file);
+}
+
+}  // namespace Evaluation
+
 namespace {
 
 /// Makes threat mask according current pattern4 counts on board.
@@ -110,8 +207,17 @@ Value evaluate(const Board &board, Value alpha, Value beta)
     if (board.evaluator()) {
         // Use evaluator eval if classical eval are in alpha-beta window margin
         int margin = classicalEvalMargin(eval);
-        if (eval >= alpha - margin && eval <= beta + margin)
+        if (eval >= alpha - margin && eval <= beta + margin) {
+            if (valueDumpEnabled()) {
+                // [Zenyth Web N1 측정 전용] 이 호출의 고전 평가 · 창을 표본과 함께 남긴다.
+                valueDumpCtx = {(int16_t)eval, (int16_t)alpha, (int16_t)beta,
+                                (int16_t)board.ply(), true};
+                Value v      = computeEvaluatorValue(board).value();
+                valueDumpCtx.valid = false;
+                return v;
+            }
             return computeEvaluatorValue(board).value();
+        }
     }
 
     return eval;
