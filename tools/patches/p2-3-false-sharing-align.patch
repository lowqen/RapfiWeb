diff --git a/Rapfi/search/searchengine.h b/Rapfi/search/searchengine.h
index 24890ac..055f329 100644
--- a/Rapfi/search/searchengine.h
+++ b/Rapfi/search/searchengine.h
@@ -92,13 +92,16 @@ struct SearchContext
     TimeControl timectl;
     /// Printer for all search messages (main search thread only)
     SearchPrinter printer;
-    /// Calls count before exit condition check (main search thread only)
-    uint32_t callsCnt;
+    /// Calls count before exit condition check (main search thread only). Decremented at every
+    /// node of the main thread, so it starts a cache line of its own, away from the options and
