+    const size_t maxThreadsAboveNextDepth = threads.size() == 2 ? 0 : threads.size() / 2;
+
     for (int nextDepth = lastDepth + 1;; nextDepth++) {
         size_t numThreadsAboveNextDepth = 0;
 
