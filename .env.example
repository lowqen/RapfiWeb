# RapfiWeb 개발 환경 변수. 이 파일을 .env 로 복사해서 쓴다(.env 는 커밋되지 않는다).
#
# 지금은 전부 선택 사항이다 — 서버 연결 기능이 없는 앱이라 비밀이 필요 없다.
# 이 파일이 존재하는 이유는 "무엇을 바꿀 수 있는가"를 한곳에 적어 두기 위해서다.

# 엔진 산출물을 어디서 읽을 것인가. 기본값은 public/engine/ 이다.
# tools/build_engine_wasm.sh 가 out/engine/ 에 만든 것을 그대로 쓰고 싶을 때 바꾼다.
VITE_ENGINE_BASE_URL=/engine/

# 가중치(.bin.lz4)를 어디서 받을 것인가. 규칙별 lazy load 가 여기를 본다(계획서 §4).
# 기본값은 같은 오리진. 릴리스 자산을 CDN 으로 서빙하면 그 URL 로 바꾼다.
VITE_WEIGHTS_BASE_URL=/weights/

# 엔진 시간 분할 조각 길이(ms). 단일 스레드 빌드는 탐색 중 워커가 통째로 막히므로,
# 이 길이마다 제어권이 돌아온다(계획서 §3). 0 이면 분할하지 않는다 —
# 멀티스레드 변형이 되살아나면(W0c) 그때 0 으로 둔다.
VITE_ENGINE_SLICE_MS=500
