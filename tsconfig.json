{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],

    /* strict, 그리고 strict 가 놓치는 것들까지. 이 저장소는 엔진 프로토콜과
       좌표계를 다루므로 undefined 하나가 조용히 잘못된 수를 만든다. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    /* scripts/ 는 tsx 로 직접 돌아가므로 .ts 확장자를 붙여 import 한다. */
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  },
  "include": ["src", "scripts", "vite.config.ts", "showcase"],
  "exclude": ["node_modules", "dist", "spike", "out", "out-diag"]
}
