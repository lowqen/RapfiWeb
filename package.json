{
  "name": "rapfiweb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "RapfiDroid 웹 이식 — 오목/렌주 분석반",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx scripts/gen-tokens.ts && vite",
    "studio": "tsx scripts/gen-tokens.ts && vite --open /joseki/studio",
    "curriculum:publish": "tsx scripts/curriculum-publish.ts",
    "build": "tsx scripts/gen-tokens.ts && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsx scripts/gen-tokens.ts && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:tokens": "tsx scripts/gen-tokens.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "engine:build": "bash tools/build_engine_wasm.sh",
    "serve": "node spike/serve.mjs",
    "w0:bench": "node spike/node-bench.mjs",
    "w0:node": "node spike/node-protocol.mjs",
    "w0:browser": "node spike/browser-test.mjs",
    "w0:summary": "node spike/summarize.mjs",
    "showcase:dev": "vite --config showcase/vite.config.ts",
    "showcase:build": "tsc --noEmit && vite build --config showcase/vite.config.ts",
    "showcase:preview": "vite preview --config showcase/vite.config.ts"
  },
  "dependencies": {
    "dexie": "^4",
    "pretendard": "1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.0",
    "vitest": "^5.0.3"
  }
}
