{
  "name": "rapfiweb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "RapfiDroid 웹 이식 — 오목/렌주 분석반",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx scripts/gen-tokens.ts && vite",
    "build": "tsx scripts/gen-tokens.ts && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsx scripts/gen-tokens.ts && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:tokens": "tsx scripts/gen-tokens.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "engine:build": "bash tools/build_engine_wasm.sh",
    "serve": "node spike/serve.mjs",
    "w0:bench": "node spike/node-bench.mjs",
    "w0:node": "node spike/node-protocol.mjs",
    "w0:browser": "node spike/browser-test.mjs",
    "w0:summary": "node spike/summarize.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "playwright": "^1.49.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
